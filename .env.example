# Copy this file to .env and fill in your SQL Server connection details.
# server.js / db.js load these via dotenv.

DB_SERVER=localhost
DB_DATABASE=JavaPipelineDB
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_PORT=1433

# Set to "true" when connecting to Azure SQL or a server requiring TLS.
DB_ENCRYPT=false
# Set to "false" only if your server has a trusted/valid TLS certificate.
DB_TRUST_SERVER_CERTIFICATE=true

PORT=8888
